---
// Main Landing Page — Pitcar Academy
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import PackageCard from '../components/PackageCard.astro';
import AdvantageSection from '../components/AdvantageSection.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaSection from '../components/CtaSection.astro';
import { packages, faqs } from '../content.config.ts';

const whatsappNumber = '6281234567890'; // Replace with actual number
const heroMessage = encodeURIComponent('Halo Pitcar Academy, saya tertarik dengan program pelatihan mekanik. Bisa info lebih lanjut?');
---

<BaseLayout
  title="Sekolah Mekanik Profesional | Pelatihan Mekanik Mobil Pitcar Academy"
  description="Program pelatihan mekanik profesional Pitcar Academy — Belajar, Praktik di Bengkel, Siap Kerja. Sertifikat resmi dari Pitcar Certified Mechanic."
>
  {/* Hero Section — Primary CTA #1 */}
  <HeroSection whatsappNumber={whatsappNumber} whatsappMessage={heroMessage} />

  {/* About / Intro Section */}
  <section id="about" class="section-padding bg-white overflow-hidden" aria-label="Tentang Pitcar Academy">
    <div class="container-custom max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <span class="inline-flex items-center gap-2 bg-red-50 text-red-700 font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-full border border-red-200/80 mb-6">
            <span class="w-2 h-2 rounded-full bg-red-600"></span>
            Tentang Kami
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-[1.1] text-slate-900 mb-6 tracking-tight">
            Belajar Dari Ahli,<br/>Praktik Langsung <span class="bg-gradient-to-r from-red-600 to-red-500 bg-clip-text text-transparent">di Bengkel</span>
          </h2>
          <div class="w-16 h-1 bg-gradient-to-r from-red-600 to-amber-500 rounded-full mb-6"></div>
          <p class="text-slate-600 text-lg leading-relaxed mb-5">
            Pitcar Academy adalah program pelatihan mekanik profesional yang diselenggarakan oleh jaringan bengkel Pitcar Service — salah satu jaringan bengkel mobil terpercaya di Indonesia.
          </p>
          <p class="text-slate-600 text-lg leading-relaxed mb-8">
            Dengan kurikulum terstruktur berdasarkan standar industri, praktik langsung di bengkel berstandar tinggi, dan bimbingan dari instruktur berpengalaman, kami memastikan setiap lulusan <strong class="text-slate-900 font-bold">siap kerja dan memiliki kompetensi yang diakui</strong>.
          </p>
          <p class="text-sm text-slate-500 italic">
            📲 Untuk konsultasi langsung, hubungi kami melalui tombol WhatsApp di pojok kanan bawah.
          </p>
        </div>
        <div class="relative">
          <div class="absolute -inset-3 bg-gradient-to-br from-red-500/10 via-transparent to-amber-500/10 rounded-[2rem] blur-2xl pointer-events-none"></div>
          <img
            src="/mechanic-practice.png"
            alt="Mekanik muda pria Pitcar Academy sedang praktik bongkar pasang mesin di bengkel"
            class="relative w-full aspect-4/3 md:aspect-square object-cover rounded-2xl border border-slate-200 shadow-2xl"
            width="800"
            height="800"
            loading="lazy"
          />
          <div class="absolute -bottom-5 -left-3 sm:left-4 bg-white/95 backdrop-blur-xl p-4 sm:p-5 rounded-2xl shadow-xl border border-slate-200/90">
            <div class="flex items-center gap-3.5">
              <div class="w-11 h-11 bg-emerald-100 rounded-xl flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div>
                <div class="font-extrabold text-slate-900 text-sm sm:text-base">Praktik di Bengkel Pitcar</div>
                <div class="text-xs font-semibold text-slate-500">Instruktur & Peralatan Standar Industri</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Packages Section — CTA per card stays (contextual & relevant) */}
  <section id="packages" class="section-padding bg-slate-50 overflow-hidden" aria-label="Paket Belajar">
    <div class="container-custom max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center gap-2 bg-red-50 text-red-700 font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-full border border-red-200/80 mb-5">
          <span class="w-2 h-2 rounded-full bg-red-600"></span>
          Program Pelatihan
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-[1.1] text-slate-900 mb-5 tracking-tight">Pilih Paket <span class="bg-gradient-to-r from-red-600 via-red-500 to-amber-500 bg-clip-text text-transparent">Belajar Anda</span></h2>
        <p class="text-slate-500 text-lg leading-relaxed">Dari pemula hingga profesional — kami punya program yang sesuai kebutuhan Anda.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {packages.map(pkg => (
          <PackageCard pkg={pkg} whatsappNumber={whatsappNumber} />
        ))}
      </div>
    </div>
  </section>

  {/* Advantages Section — No extra CTA needed */}
  <AdvantageSection />

  {/* FAQ Section — Subtle text reference only */}
  <FaqSection faqs={faqs} />

  {/* Bottom CTA — Final conversion push */}
  <CtaSection whatsappNumber={whatsappNumber} />
</BaseLayout>

<!-- Structured Data: Course per package -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "Program Pelatihan Mekanik Pitcar Academy",
  "description": "Program pelatihan mekanik profesional dengan sertifikat resmi Pitcar Certified Mechanic.",
  "provider": {
    "@type": "EducationalOrganization",
    "name": "Pitcar Academy"
  },
  "offers": [
    {
      "@type": "Offer",
      "name": "Basic Level 1",
      "price": "5000000",
      "priceCurrency": "IDR",
      "description": "Maintenance Mobil Bensin EFI"
    },
    {
      "@type": "Offer",
      "name": "Advanced Level 2",
      "price": "5000000",
      "priceCurrency": "IDR",
      "description": "General Repair Mobil EFI"
    },
    {
      "@type": "Offer",
      "name": "Professional Level 1 & 2",
      "price": "8500000",
      "priceCurrency": "IDR",
      "description": "Maintenance & General Repair"
    }
  ]
}
</script>

<!-- FAQPage Schema -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type": "Question", "name": "Apakah boleh ikut tanpa background otomotif?", "acceptedAnswer": {"@type": "Answer", "text": "Boleh! Program Basic dirancang khusus untuk pemula yang belum pernah belajar otomotif. Anda akan belajar dari nol hingga mampu mengerjakan perawatan dasar mobil."}},
    {"@type": "Question", "name": "Berapa lama total waktu pelatihan?", "acceptedAnswer": {"@type": "Answer", "text": "Basic 1 bulan kelas + 2 bulan OJT. Advanced 1 bulan kelas + 2 bulan OJT. Professional 2 bulan kelas + 2 bulan OJT."}},
    {"@type": "Question", "name": "Bagaimana sistem pembelajaran?", "acceptedAnswer": {"@type": "Answer", "text": "Kombinasi teori dan praktik. Sesi belajar di dalam kelas dilanjutkan dengan Praktik Kerja Lapangan (OJT) langsung di bengkel Pitcar Service selama 2 bulan."}},
    {"@type": "Question", "name": "Apa yang didapat setelah lulus?", "acceptedAnswer": {"@type": "Answer", "text": "Anda mendapat sertifikat resmi dari Pitcar Academy, kemampuan teknis sesuai level, pengalaman praktik di bengkel, dan kesempatan bergabung di jaringan Pitcar."}},
    {"@type": "Question", "name": "Apakah bisa cicilan?", "acceptedAnswer": {"@type": "Answer", "text": "Untuk info program pembayaran cicilan, silakan hubungi kami melalui WhatsApp. Kami memiliki beberapa pilihan payment plan yang bisa disesuaikan."}},
    {"@type": "Question", "name": "Dimana lokasi bengkel untuk OJT?", "acceptedAnswer": {"@type": "Answer", "text": "OJT dilaksanakan di bengkel-bengkel Pitcar Service yang tersebar di berbagai lokasi strategis. Detail lokasi akan disampaikan saat konfirmasi pendaftaran."}}
  ]
}
</script>
