---
// Main Landing Page — Pitcar Academy (Aligned with draft-revision.md)
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import PackageCard from "../components/PackageCard.astro";
import DifferentiatorSection from "../components/DifferentiatorSection.astro";
import AdvantageSection from "../components/AdvantageSection.astro";
import CareerPathSection from "../components/CareerPathSection.astro";
import TargetAudienceSection from "../components/TargetAudienceSection.astro";
import EcosystemGallerySection from "../components/EcosystemGallerySection.astro";
import FaqSection from "../components/FaqSection.astro";
import CtaSection from "../components/CtaSection.astro";
import { packages, faqs } from "../content.config.ts";

const whatsappNumber = "6285190950381";
const heroMessage = encodeURIComponent(
  "Halo Pitcar Academy, saya tertarik dengan program pelatihan mekanik Batch Perdana (Oktober 2026). Bisa info lebih lanjut?",
);
---

<BaseLayout
  title="Pitcar Academy | Belajar Mekanik Langsung dari Ekosistem Bengkel Nyata"
  description="Program pelatihan & sertifikasi mekanik mobil Pitcar Academy. Teori & praktik intensif + 2 Bulan OJT di lingkungan bengkel PITCAR."
  whatsappNumber={whatsappNumber}
>
  {/* Hero Section — Primary CTA #1 */}
  <HeroSection whatsappNumber={whatsappNumber} whatsappMessage={heroMessage} />

  {/* About / Intro Section — Bukan Sekadar Belajar di Kelas */}
  <section
    id="about"
    class="section-padding bg-page overflow-hidden"
    aria-label="Tentang Pitcar Academy"
  >
    <div class="container-custom">
      <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <span
            class="inline-flex items-center gap-2 bg-brand-50 text-secondary font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-full border border-brand-200 mb-6"
          >
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            Bukan Sekadar Belajar di Kelas
          </span>
          <h2 class="heading-primary mb-6">
            Belajar Mekanik Harus Bertemu dengan <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent italic"
              >Dunia Bengkel Sebenarnya</span
            >
          </h2>
          <div
            class="w-16 h-1 bg-gradient-to-r from-primary to-secondary rounded-full mb-6"
          >
          </div>
          <p
            class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed mb-5"
          >
            Mengetahui teori otomotif saja belum cukup untuk membangun
            kepercayaan diri sebagai mekanik profesional.
          </p>
          <p class="text-slate-900 dark:text-white font-extrabold text-lg mb-4">
            Karena itu Pitcar Academy menggabungkan:
          </p>

          <!-- Premium Timeline Flow -->
          <div
            class="relative pl-6 border-l-2 border-primary/20 space-y-6 my-8"
          >
            <!-- Step 1 -->
            <div class="relative group">
              <!-- Dot Indicator with Number -->
              <div
                class="absolute -left-[35px] top-1 w-6 h-6 rounded-full bg-primary text-white text-[10px] font-black flex items-center justify-center border-4 border-page shadow-md group-hover:scale-110 transition-transform"
              >
                1
              </div>
              <div
                class="p-4 rounded-2xl bg-slate-900 border border-slate-800 hover:border-primary/50 transition-all duration-300 shadow-xl text-white"
              >
                <h4 class="font-extrabold text-white text-base">Belajar</h4>
                <p
                  class="text-sm text-slate-300 mt-1 font-medium leading-relaxed"
                >
                  Materi dan metode pembelajaran dikembangkan berdasarkan
                  pengalaman operasional PITCAR dalam menangani kendaraan
                  pelanggan sehari-hari.
                </p>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="relative group">
              <div
                class="absolute -left-[35px] top-1 w-6 h-6 rounded-full bg-primary text-white text-[10px] font-black flex items-center justify-center border-4 border-page shadow-md group-hover:scale-110 transition-transform"
              >
                2
              </div>
              <div
                class="p-4 rounded-2xl bg-slate-900 border border-slate-800 hover:border-primary/50 transition-all duration-300 shadow-xl text-white"
              >
                <h4 class="font-extrabold text-white text-base">Praktik</h4>
                <p
                  class="text-sm text-slate-300 mt-1 font-medium leading-relaxed"
                >
                  Porsi pembelajaran dirancang agar peserta memiliki banyak
                  kesempatan memegang alat, melakukan pemeriksaan, memahami
                  komponen, & mengerjakan kendaraan secara langsung.
                </p>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="relative group">
              <div
                class="absolute -left-[35px] top-1 w-6 h-6 rounded-full bg-primary text-white text-[10px] font-black flex items-center justify-center border-4 border-page shadow-md group-hover:scale-110 transition-transform"
              >
                3
              </div>
              <div
                class="p-4 rounded-2xl bg-slate-900 border border-slate-800 hover:border-primary/50 transition-all duration-300 shadow-xl text-white"
              >
                <h4 class="font-extrabold text-white text-base">2 Bln OJT</h4>
                <p
                  class="text-sm text-slate-300 mt-1 font-medium leading-relaxed"
                >
                  Menjalani OJT di lingkungan bengkel PITCAR untuk menghadapi
                  dan membiasakan diri dengan ritme serta standar pekerjaan
                  bengkel yang sebenarnya.
                </p>
              </div>
            </div>

            <!-- Step 4 -->
            <div class="relative group">
              <div
                class="absolute -left-[35px] top-1 w-6 h-6 rounded-full bg-secondary text-white text-[10px] font-black flex items-center justify-center border-4 border-page shadow-md group-hover:scale-110 transition-transform"
              >
                4
              </div>
              <div
                class="p-4 rounded-2xl bg-slate-900 border border-slate-800 hover:border-primary/50 transition-all duration-300 shadow-xl text-white"
              >
                <h4 class="font-extrabold text-white text-base">
                  Pengalaman Bengkel Nyata
                </h4>
                <p
                  class="text-sm text-slate-300 mt-1 font-medium leading-relaxed"
                >
                  Membentuk kesiapan kerja yang utuh dengan portofolio riil,
                  pemecahan masalah langsung di lapangan, serta pengenalan
                  budaya kerja profesional.
                </p>
              </div>
            </div>
          </div>

          <p class="text-xs text-muted italic">
            📲 Batch perdana dimulai Oktober 2026 dengan kuota terbatas untuk
            menjaga kualitas pembelajaran.
          </p>
        </div>
        <div class="relative">
          <div
            class="absolute -inset-3 bg-gradient-to-br from-primary/10 via-transparent to-secondary/10 rounded-[2rem] blur-2xl pointer-events-none"
          >
          </div>
          <img
            src="/mechanic-practice.png"
            alt="Peserta Pitcar Academy sedang praktik di lingkungan bengkel PITCAR"
            class="relative w-full aspect-4/3 md:aspect-square object-cover rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl"
            width="800"
            height="800"
            loading="lazy"
          />
          <div
            class="absolute -bottom-5 -left-3 sm:left-4 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl p-4 sm:p-5 rounded-2xl shadow-xl border border-slate-200/90 dark:border-slate-800"
          >
            <div class="flex items-center gap-3.5">
              <div
                class="w-11 h-11 bg-brand-50 dark:bg-slate-800 rounded-xl flex items-center justify-center shrink-0"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#CC0000"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><polyline points="20 6 9 17 4 12"></polyline></svg
                >
              </div>
              <div>
                <div class="font-extrabold text-heading text-sm sm:text-base">
                  Ekosistem PITCAR
                </div>
                <div class="text-xs font-semibold text-muted">
                  Materi & Metode dari Operasional Bengkel Nyata
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Advantage Section — USP Section */}
  <AdvantageSection />

  {/* Differentiator Section — Skill -> Experience -> Character -> Career */}
  <DifferentiatorSection />

  {/* Packages Section */}
  <section
    id="packages"
    class="section-padding bg-slate-950 overflow-hidden"
    aria-label="Program Pelatihan"
  >
    <div class="container-custom">
      <div class="headline-container">
        <span
          class="inline-flex items-center gap-2 bg-white/[0.06] text-brand-300 font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-full border border-white/10 mb-5"
        >
          <span class="w-2 h-2 rounded-full bg-primary"></span>
          Pilih Program Sesuai Tujuanmu
        </span>
        <h2 class="heading-primary text-white mb-5">
          Program Pelatihan <span
            class="bg-gradient-to-r from-brand-400 to-brand-300 bg-clip-text text-transparent"
            >Pitcar Academy</span>
        </h2>
        <p class="section-subtitle">
          Dari fundamental maintenance hingga general repair lengkap + 2 bulan
          OJT bengkel.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          packages.map((pkg) => (
            <PackageCard pkg={pkg} whatsappNumber={whatsappNumber} />
          ))
        }
      </div>
    </div>
  </section>

  {/* Career Section — Dari Academy Menuju Dunia Kerja */}
  <CareerPathSection />

  {/* Target Audience Section — Siapa yang cocok? */}
  <TargetAudienceSection whatsappNumber={whatsappNumber} />

  {/* Ecosystem Gallery Section — Belajar Langsung dari Ekosistem PITCAR */}
  <EcosystemGallerySection />

  {/* FAQ Section */}
  <FaqSection faqs={faqs} />

  {/* Bottom CTA — Final conversion push */}
  <CtaSection whatsappNumber={whatsappNumber} />
</BaseLayout>

<!-- Structured Data: Course per package -->
<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "Program Pelatihan Mekanik Pitcar Academy",
    "description": "Program pelatihan & sertifikasi mekanik mobil profesional dengan 2 bulan OJT di lingkungan bengkel PITCAR.",
    "provider": {
      "@type": "EducationalOrganization",
      "name": "Pitcar Academy"
    },
    "offers": [
      {
        "@type": "Offer",
        "name": "Mechanic Level 1 — Maintenance",
        "price": "5000000",
        "priceCurrency": "IDR",
        "description": "Maintenance Mobil Bensin EFI + 2 Bulan OJT"
      },
      {
        "@type": "Offer",
        "name": "Mechanic Level 2 — General Repair",
        "price": "5000000",
        "priceCurrency": "IDR",
        "description": "General Repair Mobil EFI + 2 Bulan OJT"
      },
      {
        "@type": "Offer",
        "name": "Mechanic Level 1 + Level 2 Professional",
        "price": "8500000",
        "priceCurrency": "IDR",
        "description": "Maintenance & General Repair + 2 Bulan OJT"
      }
    ]
  }
</script>

<!-- FAQPage Schema -->
<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Apakah harus lulusan SMK Otomotif?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tidak. Program Basic dapat diikuti peserta yang ingin memulai fundamental otomotif dari awal."
        }
      },
      {
        "@type": "Question",
        "name": "Apa perbedaan Basic dan Advance?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Basic berfokus pada Maintenance, sedangkan Advance berfokus pada General Repair."
        }
      },
      {
        "@type": "Question",
        "name": "Saya ingin belajar keduanya. Program mana yang sebaiknya dipilih?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Program Professional mencakup Level 1 dan Level 2 dengan total 208 jam pembelajaran dan 2 bulan OJT."
        }
      },
      {
        "@type": "Question",
        "name": "Di mana OJT dilakukan?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "OJT dilakukan di lingkungan bengkel yang ditentukan oleh jaringan Pitcar Academy."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah setelah lulus pasti bekerja di PITCAR?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tidak ada jaminan penempatan kerja. Namun peserta dengan kompetensi, attitude, dan performa yang memenuhi standar dapat memperoleh kesempatan mengikuti proses rekrutmen sesuai kebutuhan jaringan PITCAR."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah bisa mencicil biaya pendidikan?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Skema dan pilihan pembayaran dapat ditanyakan langsung kepada tim pendaftaran kami via WhatsApp."
        }
      }
    ]
  }
</script>
