---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { contact, onlineCourses, onlineCourseFaqs, packages, trustNumbers } from '../content.config';

// Etalase, bukan halaman jual: pengunjung memilih kelas di sini, lalu
// diyakinkan di halaman kelasnya. Karena itu header dan footer tetap ada,
// sementara halaman kelas (bare) tidak punya jalan keluar selain tombol beli.
const workshopNumbers = trustNumbers.filter((n) => n.publish);
const professional = packages.find((p) => p.id === 'professional');
// Offline packages are written "Rp 8.500.000"; the online courses "Rp99.000".
// One numeral rule per page, so the offline card follows the page it sits on.
const professionalPrice = professional?.priceDisplay.replace(/^Rp\s+/, 'Rp');

const site = Astro.site ?? new URL('https://academy.pitcar.co.id');
const pageUrl = new URL('/kelas-online/', site).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Kelas Online Pitcar Academy',
    url: pageUrl,
    itemListElement: onlineCourses.map((course, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Course',
        name: course.name,
        description: course.summary,
        url: new URL(course.href, site).href,
        image: new URL(course.cover, site).href,
        inLanguage: 'id',
        provider: { '@id': new URL('/#organization', site).href },
        offers: {
          '@type': 'Offer',
          price: String(course.price),
          priceCurrency: 'IDR',
          availability: 'https://schema.org/InStock',
          category: 'Paid',
          url: new URL(course.href, site).href,
        },
        hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'Online' },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: onlineCourseFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];

const howToBuy = [
  {
    title: 'Pilih kelasnya',
    description: 'Baca isi, batasan, dan harganya di halaman kelas. Tidak ada yang disembunyikan sampai checkout.',
  },
  {
    title: 'Bayar sekali',
    description: 'Tombol beli membawa kamu ke halaman checkout. Isi data, pilih cara bayar, selesai.',
  },
  {
    title: 'Materi langsung terbuka',
    description: 'Setelah pembayaran berhasil, akses terbuka otomatis. Putar dari HP atau laptop, kapan saja, selamanya.',
  },
];
---

<BaseLayout
  title="Kelas Online Pitcar Academy — Belajar Otomotif dari Mekanik Bengkel"
  description="Pilih kelas online Pitcar Academy: Kelas AC Mobil dan Kelas Inspeksi Mobil Bekas. Disusun mekanik bengkel PITCAR, sekali bayar, akses selamanya, bisa dari HP."
  canonical="/kelas-online/"
  image="/kelas-ac/og.jpg"
  imageAlt="Kelas online Pitcar Academy: mekanik PITCAR di bengkel, kelas dasar pemeriksaan dan perawatan AC mobil."
  preloadImage="/kelas-ac/cover.webp"
  structuredData={structuredData}
  header={{
    links: [
      { href: '#kelas', label: 'Pilih kelas' },
      { href: '#cara-belajar', label: 'Cara belajar' },
      { href: '#faq', label: 'FAQ' },
    ],
    cta: { href: '#kelas', label: 'Pilih kelas', sourceCta: 'kelas_online_header' },
    showAnnouncement: false,
  }}
  floatingCta={{ href: '#kelas', label: 'Pilih kelas', sourceCta: 'kelas_online_floating', icon: false }}
>
  <!-- 1. HERO — satu janji untuk semua kelas, lalu langsung ke pilihan -->
  <section class="band pt-28 sm:pt-32 md:pt-40" aria-labelledby="hero-title">
    <div class="shell">
      <div class="max-w-4xl">
        <p class="eyebrow">Kelas online Pitcar Academy</p>
        <h1 id="hero-title" class="display-1 mt-6 max-w-[16ch]">Ilmu dari lantai bengkel, dipelajari dari HP kamu.</h1>
        <p class="lead mt-6 max-w-prose">
          Kelas online Pitcar Academy disusun dari pekerjaan mekanik PITCAR sehari-hari: apa yang diperiksa,
          bagaimana urutannya, dan kapan harus berhenti menebak. Pilih kelasnya, bayar sekali, materi langsung
          terbuka dan bisa diputar ulang selamanya.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#kelas" data-lead-cta data-source-cta="kelas_online_hero" class="btn btn-primary">Pilih kelas</a>
          <a href="#cara-belajar" class="btn btn-ghost">Cara belajar</a>
        </div>
      </div>

      <dl class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {[
          { label: 'Kelas tersedia', value: `${onlineCourses.length} kelas` },
          { label: 'Pembayaran', value: 'Sekali bayar' },
          { label: 'Masa akses', value: 'Selamanya' },
          { label: 'Perangkat', value: 'HP, tablet, laptop' },
        ].map((fact) => (
          <div class="bg-surface px-5 py-4">
            <dt class="text-xs font-bold uppercase tracking-[0.14em] text-muted">{fact.label}</dt>
            <dd class="mt-1 font-display text-2xl font-bold leading-none">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 2. PILIH KELAS — kartu dengan isi, harga, dan dua jalan: baca dulu atau langsung beli -->
  <section id="kelas" class="band band-alt border-t border-line scroll-mt-28" aria-labelledby="courses-title">
    <div class="shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Pilih kelas</p>
        <h2 id="courses-title" class="display-2 mt-6">Mulai dari masalah yang sedang kamu hadapi.</h2>
        <p class="lead mt-5">
          Setiap kelas berdiri sendiri. Tidak ada urutan yang harus diikuti, tidak ada paket yang harus diambil.
        </p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-2">
        {onlineCourses.map((course) => (
          <article class="flex flex-col border border-line bg-surface">
            <a href={course.href} data-lead-cta data-source-cta={`kelas_online_cover_${course.id}`} class="block border-b border-line" aria-label={`Lihat ${course.name}`}>
              <img
                src={course.cover}
                srcset={course.coverSrcset}
                sizes="(min-width: 1024px) 40rem, 100vw"
                width={course.coverWidth}
                height={course.coverHeight}
                loading={course.badge ? 'eager' : 'lazy'}
                alt={course.coverAlt}
                class="aspect-square w-full object-cover object-top"
              />
            </a>
            <div class="flex flex-1 flex-col p-6 sm:p-8">
              <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                <p class="text-xs font-bold uppercase tracking-[0.14em] text-muted">Kelas online</p>
                {course.badge && (
                  <span class="bg-accent-fill px-2.5 py-1 text-[0.6875rem] font-bold uppercase tracking-wider text-white">{course.badge}</span>
                )}
              </div>
              <h3 class="display-3 mt-4">{course.name}</h3>
              <p class="mt-3 font-display text-2xl font-bold leading-tight text-accent sm:text-3xl">{course.hook}</p>
              <p class="mt-3 text-sm leading-relaxed text-muted">{course.summary}</p>

              <ul class="mt-6 grid gap-x-6 gap-y-2.5 border-t border-line pt-6 text-sm font-semibold sm:grid-cols-2">
                {course.highlights.map((item) => (
                  <li class="flex items-center gap-2.5">
                    <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    {item}
                  </li>
                ))}
              </ul>
              <p class="mt-4 text-sm text-muted"><span class="font-semibold text-body">Cocok untuk:</span> {course.forWho}</p>

              <div class="mt-auto border-t border-line pt-6">
                <div class="mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="font-display text-4xl font-bold leading-none">{course.priceDisplay}</span>
                  <span class="text-base text-muted line-through">{course.strikePriceDisplay}</span>
                  <span class="bg-accent-fill px-2 py-0.5 text-[0.6875rem] font-bold uppercase tracking-wider text-white">{course.priceLabel}</span>
                </div>
                <p class="mt-2 text-xs text-muted">Sekali bayar · Akses selamanya · Akses langsung setelah pembayaran</p>
                <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                  <a href={course.href} data-lead-cta data-source-cta={`kelas_online_detail_${course.id}`} class="btn btn-primary flex-1">Lihat isi kelas</a>
                  <a
                    href={course.checkoutUrl}
                    data-checkout
                    data-item-id={course.id}
                    data-item-name={course.name}
                    data-price={course.price}
                    data-source-cta={`kelas_online_buy_${course.id}`}
                    class="btn btn-ghost flex-1"
                  >
                    Langsung beli
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. CARA BELAJAR -->
  <section id="cara-belajar" class="band border-t border-line scroll-mt-28" aria-labelledby="steps-title">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow">Cara belajar</p>
          <h2 id="steps-title" class="display-2 mt-6">Tiga langkah. Tidak ada jadwal, tidak ada antrean.</h2>
          <p class="lead mt-5">
            Keputusan beli kelas online harusnya selesai dalam hitungan menit, bukan lewat percakapan panjang.
            Kalau tetap ingin bertanya dulu, WhatsApp kami ada di bawah.
          </p>
        </div>
        <ol class="divide-y divide-line border-y border-line lg:col-span-7">
          {howToBuy.map((step, i) => (
            <li class="grid grid-cols-[6rem_1fr] gap-4 py-6">
              <span class="font-display text-sm font-semibold uppercase tracking-[0.14em] text-accent">Langkah {i + 1}</span>
              <div>
                <h3 class="display-3">{step.title}</h3>
                <p class="mt-1.5 text-muted">{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 4. KENAPA DARI PITCAR — bengkel yang beroperasi, bukan studio -->
  <section class="band band-alt border-t border-line" aria-labelledby="why-title">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow">Kenapa dari Pitcar Academy</p>
        <h2 id="why-title" class="display-2 mt-6">Diajarkan oleh orang yang besok paginya tetap mengerjakan mobil customer.</h2>
        <p class="lead mt-5 max-w-prose">
          Pitcar Academy adalah bagian dari ekosistem bengkel PITCAR. Yang menyusun materi adalah mekanik
          yang menangani kendaraan setiap hari, jadi urutan kerja di kelas sama dengan urutan kerja di bengkel.
          Kami juga menulis batasan tiap kelas sebelum harganya, bukan sesudah kamu bayar.
        </p>
      </div>
      <div class="lg:col-span-5">
        <div class="border border-line bg-surface p-8 sm:p-10">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-muted">Dari bengkel yang beroperasi</p>
          <p class="display-3 mt-4">{contact.placeName}</p>
          <dl class="mt-6 divide-y divide-line border-t border-line">
            {workshopNumbers.map((n) => (
              <div class="flex items-baseline justify-between gap-4 py-3.5">
                <dt class="text-sm text-muted">{n.label}</dt>
                <dd class="font-display text-2xl font-bold leading-none">{n.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <FaqSection
    faqs={onlineCourseFaqs}
    cta={{ note: 'Sudah tahu kelas mana yang kamu butuhkan?', href: '#kelas', label: 'Pilih kelas', sourceCta: 'kelas_online_faq' }}
  />

  <!-- 6. TANGGA — kelas online adalah pintu, program offline adalah tujuannya -->
  <section class="band border-t border-line" aria-labelledby="ladder-title">
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class="lg:col-span-7">
          <p class="eyebrow">Mau jadi mekanik?</p>
          <h2 id="ladder-title" class="display-2 mt-6">Kelas online membangun pemahaman. Praktiknya ada di bengkel.</h2>
          <p class="lead mt-5 max-w-prose">
            Praktik pada kendaraan sungguhan, OJT di bengkel yang beroperasi, dan assessment kompetensi
            hanya ada di program offline Pitcar Academy.
          </p>
        </div>
        <div class="lg:col-span-5">
          <div class="border border-line bg-surface p-6 sm:p-8">
            <p class="eyebrow">Program offline</p>
            <h3 class="display-3 mt-4">{professional?.name}</h3>
            <p class="mt-3 text-sm text-muted">{professional?.subtitle}</p>
            <p class="mt-5 font-display text-3xl font-bold leading-none">{professionalPrice}</p>
            <a href="/#program" data-lead-cta data-source-cta="kelas_online_ladder" class="btn btn-ghost mt-6 w-full">Lihat program offline</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ items: onlineCourses.map((c) => ({ item_id: c.id, item_name: c.name, price: c.price })) }}>
  // Katalog: GA4 view_item_list saat halaman dibuka, begin_checkout saat
  // tombol "Langsung beli" ditekan. Halaman kelas masing-masing mengirim
  // view_item-nya sendiri.
  document.addEventListener('DOMContentLoaded', () => {
    window.trackFunnelEvent?.('view_item_list', { item_list_id: 'kelas_online', item_list_name: 'Kelas online', items });
  });

  const attributionParams = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'ttclid', 'fbclid'];

  document.addEventListener('click', (event) => {
    const link = event.target?.closest?.('[data-checkout]');
    if (!link) return;
    if (link.hostname.endsWith('myscalev.com')) {
      const from = new URLSearchParams(window.location.search);
      const to = new URL(link.href);
      for (const key of attributionParams) {
        if (from.has(key) && !to.searchParams.has(key)) to.searchParams.set(key, from.get(key));
      }
      link.href = to.toString();
    }
    const price = Number(link.dataset.price) || 0;
    const item = { item_id: link.dataset.itemId, item_name: link.dataset.itemName, price, quantity: 1 };
    window.trackFunnelEvent?.('begin_checkout', { currency: 'IDR', value: price, items: [item], source_cta: link.dataset.sourceCta || 'unknown' });
    window.fbq?.('track', 'InitiateCheckout', { value: price, currency: 'IDR', content_name: item.item_name, content_ids: [item.item_id], content_type: 'product' });
  });
</script>
