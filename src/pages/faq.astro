---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { faqs, whatsappConfig } from '../content.config.ts';

const whatsappNumber = whatsappConfig.phoneNumber;
---

<BaseLayout
  title="FAQ - Pertanyaan Umum | Pitcar Academy"
  description="Jawaban untuk pertanyaan umum seputar program pelatihan mekanik Pitcar Academy: durasi, biaya, metode belajar, dan peluang karier."
  whatsappNumber={whatsappNumber}
>
  {/* Header */}
  <div class="hero-gradient pt-32 pb-20 md:pt-40 md:pb-28 border-b border-slate-800">
    <div class="container-custom text-center">
      <span class="inline-flex items-center gap-2 bg-white/10 text-white font-bold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full border border-white/20 mb-4 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        Pusat Bantuan
      </span>
      <h1 class="hero-title text-white mb-4 text-glow-white">Pertanyaan Umum</h1>
      <p class="section-subtitle max-w-2xl mx-auto">Temukan jawaban lengkap seputar program pelatihan, biaya, sertifikasi, dan prospek kerja.</p>
    </div>
  </div>

  {/* FAQ Section */}
  <FaqSection whatsappNumber={whatsappNumber} faqs={faqs} />
</BaseLayout>
