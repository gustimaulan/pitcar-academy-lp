---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { faqs } from '../content.config.ts';

const whatsappNumber = '6281234567890';
---

<BaseLayout
  title="FAQ - Pertanyaan Umum | Pitcar Academy"
  description="Jawaban untuk pertanyaan umum seputar program pelatihan mekanik Pitcar Academy: durasi, biaya, metode belajar, dan peluang karier."
>
  {/* Header */}
  <div class="hero-gradient pt-32 pb-20 md:pt-40 md:pb-28 border-b border-slate-800">
    <div class="container-custom text-center">
      <span class="inline-flex items-center gap-2 bg-white/10 text-white font-bold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full border border-white/20 mb-4 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        Pusat Bantuan
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white leading-tight mb-4 tracking-tight">Pertanyaan Umum</h1>
      <p class="text-lg sm:text-xl text-slate-200 max-w-2xl mx-auto font-normal leading-relaxed">Temukan jawaban lengkap seputar program pelatihan, biaya, sertifikasi, dan prospek kerja.</p>
    </div>
  </div>

  {/* FAQ Section */}
  <FaqSection whatsappNumber={whatsappNumber} faqs={faqs} />
</BaseLayout>
