---
import { Image } from 'astro:assets';
import sneakpeek1 from '../assets/kelas-inspeksi/sneakpeek-1.jpg';
import sneakpeek2 from '../assets/kelas-inspeksi/sneakpeek-2.jpg';
import sneakpeek3 from '../assets/kelas-inspeksi/sneakpeek-3.jpg';
import sneakpeek4 from '../assets/kelas-inspeksi/sneakpeek-4.jpg';
import sneakpeek5 from '../assets/kelas-inspeksi/sneakpeek-5.jpg';
import sneakpeek6 from '../assets/kelas-inspeksi/sneakpeek-6.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { contact, inspectionCourse as c, inspectionFaqs } from '../content.config';

// Until a payment platform is connected the sale still happens — over
// WhatsApp, with the product already named so nobody has to type it.
const whatsappNumber = import.meta.env.PUBLIC_EDUCATION_CONSULTANT_WHATSAPP || contact.whatsappNumber;
const checkoutHref = c.checkoutUrl
  ?? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Halo Pitcar Academy, saya mau beli ${c.name} (${c.priceDisplay}).`)}`;
const checkoutIsExternal = /^https?:\/\//.test(checkoutHref);
const checkoutLabel = `Beli kelasnya — ${c.priceDisplay}`;

const site = Astro.site ?? new URL('https://academy.pitcar.co.id');
const pageUrl = new URL('/kelas-online-inspeksi/', site).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: c.name,
    description: c.subheadline,
    url: pageUrl,
    image: new URL('/kelas-inspeksi/og.jpg', site).href,
    inLanguage: 'id',
    provider: { '@id': new URL('/#organization', site).href },
    offers: {
      '@type': 'Offer',
      price: String(c.price),
      priceCurrency: 'IDR',
      availability: 'https://schema.org/InStock',
      category: 'Paid',
      url: pageUrl,
    },
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'Online',
      courseWorkload: 'Self-paced',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: inspectionFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];

const checkoutAttrs = {
  href: checkoutHref,
  'data-checkout': '',
  ...(checkoutIsExternal && !c.checkoutUrl ? { target: '_blank', rel: 'noopener' } : {}),
};
---

<BaseLayout
  title={`${c.name} — Cek Sebelum Beli | Pitcar Academy`}
  description={`Pelajari cara mengecek mobil bekas secara sistematis sebelum membeli. Video, form inspeksi dengan scoring, ringkasan red flag, lifetime access. ${c.priceLabel} ${c.priceDisplay}.`}
  canonical="/kelas-online-inspeksi/"
  image="/kelas-inspeksi/og.jpg"
  preloadImage="/kelas-inspeksi/cover.webp"
  structuredData={structuredData}
  bare
  floatingCta={{ href: '#harga', label: `Beli kelas — ${c.priceDisplay}`, sourceCta: 'inspeksi_floating', icon: false }}
>
  <!-- 1. HERO — masalah, janji, harga, dan tombol beli dalam satu layar -->
  <section class="band pt-16 md:pt-24" aria-labelledby="hero-title">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class="lg:col-span-7">
          <p class="eyebrow">Ceklis beli mobil bekas agar tidak rugi</p>
          <h1 id="hero-title" class="display-1 mt-6 max-w-[14ch]">{c.headline}</h1>
          <p class="lead mt-6 max-w-prose">{c.subheadline}</p>
          <span id="learning-time-sentinel" class="block h-px w-px" aria-hidden="true"></span>
          <p id="learning-time" class="course-learning-time mt-5 flex items-center gap-2 border-l-2 border-accent-fill pl-3 text-sm font-semibold">
            <svg aria-hidden="true" class="h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
            <span><strong class="text-accent">Tidak sampai 1 jam</strong> untuk memahami dasar inspeksi mobil bekas.</span>
          </p>

          <ul class="mt-8 grid gap-x-6 gap-y-3 border-y border-line py-5 text-sm font-semibold sm:grid-cols-2">
            {['Video pembelajaran', 'Form inspeksi + scoring', 'Ringkasan red flag', 'Lifetime access'].map((item) => (
              <li class="flex items-center gap-2.5">
                <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                {item}
              </li>
            ))}
          </ul>

          <div class="mt-8 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-display text-5xl font-bold leading-none">{c.priceDisplay}</span>
            <span class="text-lg text-muted line-through">{c.strikePriceDisplay}</span>
            <span class="bg-accent-fill px-2 py-0.5 text-[0.6875rem] font-bold uppercase tracking-wider text-white">{c.priceLabel}</span>
          </div>
          <p class="mt-2 text-sm text-muted">Sekali bayar · Lifetime access · Akses langsung setelah pembayaran</p>

          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a {...checkoutAttrs} data-source-cta="inspeksi_hero" class="btn btn-primary">{checkoutLabel}</a>
            <a href="#isi-kelas" class="btn btn-ghost">Lihat isi kelas</a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <img
            src="/kelas-inspeksi/cover.webp"
            srcset="/kelas-inspeksi/cover-640.webp 640w, /kelas-inspeksi/cover.webp 1000w"
            sizes="(min-width: 1024px) 40vw, 100vw"
            width="1000"
            height="1000"
            fetchpriority="high"
            alt="Trainer Pitcar Academy di area bengkel, dengan form inspeksi berisi checklist eksterior, interior, mesin, transmisi, kaki-kaki, dan elektrikal."
            class="w-full border border-line"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- RISIKO FINANSIAL — akibat membeli tanpa basic inspeksi -->
  <section class="band border-t border-line" aria-labelledby="loss-title">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">Risiko tanpa basic inspeksi</p>
        <h2 id="loss-title" class="display-2 mt-6">Yang tidak terlihat saat membeli bisa jadi tagihan setelah mobil dibawa pulang.</h2>
        <p class="lead mt-5">
          Tanpa basic inspeksi, kamu tidak punya cukup informasi untuk menilai risiko, menawar harga,
          atau memutuskan kapan harus meninggalkan sebuah unit.
        </p>
      </div>

      <ol class="border-y border-line lg:col-span-7">
        <li class="grid gap-3 border-b border-line py-7 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] sm:gap-8">
          <h3 class="display-3 flex items-start gap-3"><span aria-hidden="true">❌</span><span>Kerusakan mahal terlewat</span></h3>
          <p class="leading-relaxed text-muted">
            Gejala pada mesin, transmisi, kaki-kaki, atau elektrikal bisa tampak sepele saat pengecekan singkat,
            lalu berubah menjadi biaya perbaikan jutaan rupiah.
          </p>
        </li>
        <li class="grid gap-3 border-b border-line py-7 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] sm:gap-8">
          <h3 class="display-3 flex items-start gap-3"><span aria-hidden="true">❌</span><span>Harga beli terlalu tinggi</span></h3>
          <p class="leading-relaxed text-muted">
            Tanpa catatan temuan, kamu kehilangan dasar untuk menawar. Kekurangan unit tidak masuk perhitungan,
            tetapi biaya perbaikannya tetap kamu tanggung.
          </p>
        </li>
        <li class="grid gap-3 py-7 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] sm:gap-8">
          <h3 class="display-3 flex items-start gap-3"><span aria-hidden="true">❌</span><span>Salah unit, sulit kembali</span></h3>
          <p class="leading-relaxed text-muted">
            Setelah transaksi selesai, masalah tersembunyi menjadi tanggung jawabmu. Uang keluar untuk bengkel,
            waktu habis untuk perbaikan, dan nilai jual kembali ikut turun.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 2. MASALAH — "kelihatannya bagus" bukan dasar keputusan -->
  <section class="band band-alt border-t border-line" aria-labelledby="problem-title">
    <div class="shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Kenapa perlu</p>
        <h2 id="problem-title" class="display-2 mt-6">Mobil bekas jarang terlihat buruk saat dipajang.</h2>
        <p class="lead mt-5">
          Bodi sudah dipoles, kabin wangi, mesin dipanaskan sebelum kamu datang. Tanpa urutan pengecekan
          yang jelas, keputusan sebesar ini akhirnya diambil dari kesan pertama dan cerita penjual.
        </p>
      </div>

      <div class="mt-12 grid gap-px border border-line bg-line md:grid-cols-2">
        <figure class="bg-surface p-8 sm:p-10">
          <figcaption class="text-xs font-bold uppercase tracking-[0.14em] text-muted">Tanpa panduan</figcaption>
          <blockquote class="mt-5 font-display text-3xl font-bold leading-tight text-muted sm:text-4xl">
            “Kelihatannya bagus.”
          </blockquote>
          <ul class="mt-6 space-y-2.5 text-sm text-muted">
            <li>Bingung harus mulai mengecek dari mana</li>
            <li>Ada bagian yang terlewat karena terburu-buru</li>
            <li>Sulit membandingkan satu unit dengan unit lain</li>
          </ul>
        </figure>
        <figure class="bg-surface p-8 sm:p-10">
          <figcaption class="text-xs font-bold uppercase tracking-[0.14em] text-accent">Dengan kelas ini</figcaption>
          <blockquote class="mt-5 font-display text-3xl font-bold leading-tight sm:text-4xl">
            “{c.tagline}”
          </blockquote>
          <ul class="mt-6 space-y-2.5 text-sm">
            <li>Urutan pengecekan yang runtut, area demi area</li>
            <li>Setiap temuan tercatat di form dan diberi skor</li>
            <li>Tahu kapan harus minta pemeriksaan lanjutan</li>
          </ul>
        </figure>
      </div>
    </div>
  </section>

  <!-- 3. YANG DIDAPAT -->
  <section id="isi-kelas" class="band border-t border-line scroll-mt-28" aria-labelledby="includes-title">
    <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">Yang kamu dapatkan</p>
        <h2 id="includes-title" class="display-2 mt-6">Sekali bayar, semua ini jadi milikmu.</h2>
        <p class="lead mt-5">
          Bukan sekadar video. Form inspeksinya yang kamu bawa ke lokasi, supaya apa yang dipelajari
          benar-benar dipakai saat berhadapan dengan unitnya.
        </p>
      </div>
      <ol class="divide-y divide-line border-y border-line lg:col-span-7">
        {c.includes.map((item) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-4 py-6">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center text-accent" aria-hidden="true">
              {item.title === 'Video pembelajaran' && (
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="m10 9 5 3-5 3z"></path></svg>
              )}
              {item.title === 'Form Inspeksi Mobil Bekas' && (
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"></rect><path d="M9 3.5h6M9 9h6M9 13h6M9 17h3"></path></svg>
              )}
              {item.title === 'Ringkasan red flag' && (
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 17H3z"></path><path d="M12 9v4M12 17h.01"></path></svg>
              )}
              {item.title === 'Lifetime access' && (
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
              )}
              {item.title === 'Akses langsung' && (
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-8 12h7l-1 8 8-12h-7z"></path></svg>
              )}
            </span>
            <div>
              <h3 class="display-3">{item.title}</h3>
              <p class="mt-1.5 text-muted">{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. SNEAK PEEK MATERI -->
  <section id="sneakpeek" class="band border-t border-line" aria-labelledby="sneakpeek-title">
    <div class="shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Materi dari praktisi inspeksi</p>
        <h2 id="sneakpeek-title" class="display-2 mt-6">Video produksi sendiri, bukan buatan AI.</h2>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[sneakpeek1, sneakpeek2, sneakpeek3, sneakpeek4, sneakpeek5, sneakpeek6].map((image, index) => (
          <figure class="overflow-hidden border border-line bg-surface">
            <Image
              src={image}
              format="webp"
              alt={`Capture materi kelas inspeksi mobil bekas ${index + 1}`}
              class="h-auto w-full"
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. AREA INSPEKSI — isi form, sesuai materi promosi -->
  <section class="band band-alt border-t border-line" aria-labelledby="areas-title">
    <div class="shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Form inspeksi</p>
        <h2 id="areas-title" class="display-2 mt-6">Enam area yang kamu cek, satu per satu.</h2>
        <p class="lead mt-5">
          Checklist dan scoring ada dalam satu form. Hasilnya bukan lagi perasaan, tapi catatan
          yang bisa kamu baca ulang dan bandingkan antar-unit.
        </p>
      </div>
      <dl class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {c.inspectionAreas.map((area) => (
          <div class="bg-surface p-6 sm:p-8">
            <dt class="display-3 flex items-center gap-3 font-display font-bold">
              <svg aria-hidden="true" class="h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><polyline points="8 12 11 15 16 9"></polyline></svg>
              {area.title}
            </dt>
            <dd class="mt-2 text-sm leading-relaxed text-muted">{area.description}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 5. CARA PAKAI — dari rumah sampai keputusan -->
  <section id="cara-pakai" class="band border-t border-line scroll-mt-28" aria-labelledby="steps-title">
    <div class="shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Cara pakai</p>
        <h2 id="steps-title" class="display-2 mt-6">Dari layar HP sampai keputusan beli.</h2>
      </div>
      <ol class="mt-12 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {c.steps.map((step, i) => (
          <li class="border-t-2 border-accent-fill pt-5">
            <span class="font-display text-sm font-semibold uppercase tracking-[0.14em] text-accent">Langkah {i + 1}</span>
            <h3 class="display-3 mt-2">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. COCOK UNTUK + BATASAN — jujur sebelum persuasif -->
  <section class="band band-alt border-t border-line" aria-labelledby="audience-title">
    <div class="shell grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow">Cocok untuk</p>
        <h2 id="audience-title" class="display-2 mt-6">Kelas ini untuk kamu yang:</h2>
        <ul class="mt-8 divide-y divide-line border-y border-line">
          {c.audience.map((a) => (
            <li class="flex items-start gap-4 py-4">
              <svg aria-hidden="true" class="mt-1 h-5 w-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span class="text-lg leading-snug">{a}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="self-start border border-line bg-surface p-8 sm:p-10">
        <p class="eyebrow">Yang perlu dipahami</p>
        <h3 class="display-3 mt-5">Kelas ini membantu pengecekan awal yang lebih sistematis.</h3>
        <ul class="mt-6 space-y-3 text-muted">
          {c.notFor.map((n) => (
            <li class="flex items-start gap-3">
              <span class="mt-2.5 h-1 w-3 shrink-0 bg-faint" aria-hidden="true"></span>{n}
            </li>
          ))}
        </ul>
        <p class="mt-6 border-t border-line pt-6 text-sm leading-relaxed">
          Tujuannya: kamu tahu <strong>apa yang perlu dicek</strong>, <strong>apa yang perlu diperhatikan</strong>,
          dan <strong>kapan sebuah temuan perlu diperiksa lebih lanjut</strong> oleh mekanik atau inspector profesional.
        </p>
      </div>
    </div>
  </section>

  <!-- 7. HARGA -->
  <section class="band border-t border-line" aria-labelledby="price-title">
    <div class="shell">
      <div class="mx-auto max-w-xl border-2 border-accent-fill bg-surface p-8 sm:p-12">
        <p id="harga" class="eyebrow scroll-mt-28">{c.priceLabel}</p>
        <h2 id="price-title" class="display-3 mt-5">{c.name}</h2>
        <div class="mt-6 flex flex-wrap items-baseline gap-x-3">
          <span class="font-display text-6xl font-bold leading-none">{c.priceDisplay}</span>
          <span class="text-xl text-muted line-through">{c.strikePriceDisplay}</span>
        </div>
        <p class="mt-2 text-sm text-muted">Sekali bayar · Lifetime access · Akses langsung setelah pembayaran</p>

        <ul class="mt-8 space-y-3 border-t border-line pt-6">
          {c.includes.map((item) => (
            <li class="flex items-start gap-3">
              <svg aria-hidden="true" class="mt-1 h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span class="font-semibold">{item.title}</span>
            </li>
          ))}
        </ul>

        <a {...checkoutAttrs} data-source-cta="inspeksi_pricing" class="btn btn-primary mt-8 w-full">{checkoutLabel}</a>
        <p class="mt-3 flex items-center justify-center gap-1.5 text-xs text-muted">
          <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <span>Pembayaran aman · data kamu terlindungi</span>
        </p>
        {!c.checkoutUrl && (
          <p class="mt-3 text-center text-xs text-muted">Pembelian diproses lewat WhatsApp tim Pitcar Academy.</p>
        )}
        <p class="mt-6 border-t border-line pt-6 text-xs leading-relaxed text-muted">
          <strong class="text-body">Catatan:</strong> {c.refundNote}
        </p>
      </div>
    </div>
  </section>

  <!-- 8. FAQ -->
  <FaqSection
    faqs={inspectionFaqs}
    cta={{ note: 'Sudah jelas? Pelajari caranya sebelum kamu melihat unit berikutnya.', href: '#harga', label: `Beli ${c.priceDisplay}`, sourceCta: 'inspeksi_faq' }}
  />

  <!-- 9. PENUTUP -->
  <section class="band border-t border-line" aria-labelledby="closing-title">
    <div class="shell text-center">
      <p class="eyebrow justify-center">Sebelum kamu transfer DP</p>
      <h2 id="closing-title" class="display-2 mx-auto mt-6 max-w-[18ch]">{c.tagline}</h2>
      <p class="lead mx-auto mt-5 max-w-prose">Pelajari cara cek mobil bekas sebelum mengambil keputusan beli.</p>
      <a {...checkoutAttrs} data-source-cta="inspeksi_closing" class="btn btn-primary mt-8">{checkoutLabel}</a>
      <p class="mt-3 text-xs text-muted">{c.priceLabel} · harga normal {c.strikePriceDisplay}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .course-learning-time.is-floating {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 60;
    justify-content: center;
    margin-top: 0;
    border: 0;
    background-color: #cc0000;
    color: #ffffff;
    padding: 0.75rem 1rem;
  }

  .course-learning-time.is-floating svg,
  .course-learning-time.is-floating .text-accent {
    color: #ffffff;
  }
</style>

<script>
  const learningTime = document.getElementById('learning-time');
  const learningTimeSentinel = document.getElementById('learning-time-sentinel');
  if (learningTime && learningTimeSentinel && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(([entry]) => {
      learningTime.classList.toggle('is-floating', !entry.isIntersecting);
    }, { threshold: 0, rootMargin: '-80px 0px 0px' });
    observer.observe(learningTimeSentinel);
  }
</script>

<script define:vars={{ price: c.price, itemName: c.name }}>
  // GA4 ecommerce shape, so the purchase funnel can be built on standard
  // reports. add_to_cart records intent before payment happens elsewhere.
  const item = { item_id: 'kelas-inspeksi-mobil-bekas', item_name: itemName, price, quantity: 1 };
  const commerce = { currency: 'IDR', value: price, items: [item] };

  // Inline scripts run before the bundled analytics module defines
  // trackFunnelEvent; module scripts are done by DOMContentLoaded.
  document.addEventListener('DOMContentLoaded', () => window.trackFunnelEvent?.('view_item', commerce));

  // Scalev reads these off its own URL, so carrying them across keeps the
  // ad source attached to the order.
  const attributionParams = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'ttclid', 'fbclid'];

  document.addEventListener('click', (event) => {
    const link = event.target?.closest?.('[data-checkout]');
    if (!link) return;
    if (link.hostname.endsWith('myscalev.com')) {
      const from = new URLSearchParams(window.location.search);
      const to = new URL(link.href);
      for (const key of attributionParams) {
        if (from.has(key) && !to.searchParams.has(key)) to.searchParams.set(key, from.get(key));
      }
      link.href = to.toString();
    }
    window.trackFunnelEvent?.('add_to_cart', { ...commerce, source_cta: link.dataset.sourceCta || 'unknown' });
    window.fbq?.('track', 'AddToCart', { value: price, currency: 'IDR', content_name: itemName, content_ids: [item.item_id], content_type: 'product' });
  });
</script>
