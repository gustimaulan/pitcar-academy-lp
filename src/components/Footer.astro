---
const year = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-300 border-t border-slate-800/80">
  <!-- CTA Banner -->
  <div class="border-b border-slate-800/80 bg-slate-900/50">
    <div class="container-custom max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-white text-2xl md:text-3xl font-extrabold mb-2 tracking-tight">Siap Memulai Karier Sebagai Mekanik Profesional?</h3>
          <p class="text-slate-300 max-w-xl text-base font-normal leading-relaxed">Daftar sekarang dan wujudkan impianmu menjadi mekanik bersertifikat bersama Pitcar Academy.</p>
        </div>
        <a
          href={`https://wa.me/${Astro.props.whatsappNumber ?? '6281234567890'}?text=${Astro.props.whatsappMessage}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp shrink-0 px-7 py-3.5"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Daftar via WhatsApp
        </a>
      </div>
    </div>
  </div>

  <!-- Footer Content -->
  <div class="container-custom max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-red-600 rounded-lg flex items-center justify-center shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
          </div>
          <div>
            <span class="text-white font-extrabold text-xl tracking-tight">PITCAR</span><span class="text-red-500 font-extrabold text-xl ml-1">ACADEMY</span>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed mb-6 font-normal">Belajar • Praktik • Siap Kerja<br/>Program pelatihan mekanik profesional dengan kurikulum terstruktur.</p>
        <div class="flex gap-3">
          <!-- Instagram -->
          <a href="#" aria-label="Instagram" class="w-10 h-10 bg-slate-900 border border-slate-800 hover:bg-red-600 hover:border-red-600 text-slate-300 hover:text-white rounded-xl flex items-center justify-center transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <!-- YouTube -->
          <a href="#" aria-label="YouTube" class="w-10 h-10 bg-slate-900 border border-slate-800 hover:bg-red-600 hover:border-red-600 text-slate-300 hover:text-white rounded-xl flex items-center justify-center transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.1c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.43z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
          </a>
          <!-- TikTok -->
          <a href="#" aria-label="TikTok" class="w-10 h-10 bg-slate-900 border border-slate-800 hover:bg-red-600 hover:border-red-600 text-slate-300 hover:text-white rounded-xl flex items-center justify-center transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15.2a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.73a8.19 8.19 0 0 0 4.76 1.52V6.8a4.84 4.84 0 0 1-1-.11z"/></svg>
          </a>
        </div>
      </div>

      <!-- Programs -->
      <div>
        <h4 class="text-white font-extrabold text-base mb-4 uppercase tracking-wider">Program Belajar</h4>
        <ul class="space-y-3">
          <li><a href="#packages" class="text-sm font-normal text-slate-300 hover:text-white transition-colors">Basic - Maintenance EFI</a></li>
          <li><a href="#packages" class="text-sm font-normal text-slate-300 hover:text-white transition-colors">Advanced - General Repair</a></li>
          <li><a href="#packages" class="text-sm font-normal text-slate-300 hover:text-white transition-colors">Professional - Level 1 & 2</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="text-white font-extrabold text-base mb-4 uppercase tracking-wider">Informasi</h4>
        <ul class="space-y-3">
          <li><a href="#about" class="text-sm font-normal text-slate-300 hover:text-white transition-colors">Tentang Kami</a></li>
          <li><a href="#advantages" class="text-sm font-normal text-slate-300 hover:text-white transition-colors">Keunggulan</a></li>
          <li><a href="#faq" class="text-sm font-normal text-slate-300 hover:text-white transition-colors">FAQ</a></li>
          <li><a href="https://pitcar.co.id" target="_blank" rel="noopener noreferrer" class="text-sm font-normal text-slate-300 hover:text-white transition-colors">Pitcar.co.id</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-white font-extrabold text-base mb-4 uppercase tracking-wider">Kontak</h4>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2.5 text-slate-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 shrink-0 text-red-500" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Bengkel Pitcar Service<br/>Jakarta, Indonesia</span>
          </li>
          <li class="flex items-center gap-2.5 text-slate-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-red-500"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>{Astro.props.whatsappNumberDisplay || '+62 812-3456-7890'}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-slate-800/80 bg-slate-950">
    <div class="container-custom max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-medium text-slate-400">
      <p>&copy; {year} Pitcar Academy. All rights reserved.</p>
      <p>A part of <a href="https://pitcar.co.id" target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-white font-semibold transition-colors">Pitcar Group</a></p>
    </div>
  </div>
</footer>
