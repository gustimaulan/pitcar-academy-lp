---
// Advantage Section — Bold Dark Mode with Differentiated Icons
// No CTA here — conversion handled by Hero, Sticky Float, and Bottom Banner
---

<section id="advantages" class="relative section-padding bg-slate-950 overflow-hidden" aria-label="Keunggulan Pitcar Academy">
  <!-- Ambient glow -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-red-600/10 rounded-full blur-[150px] pointer-events-none"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-amber-500/10 rounded-full blur-[150px] pointer-events-none"></div>

  <div class="container-custom max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    {/* Header */}
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 bg-white/[0.06] text-red-400 font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-full border border-white/10 mb-5">
        <span class="w-2 h-2 rounded-full bg-red-500"></span>
        Mengapa Kami
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight text-white mb-5 tracking-tight">
        Keunggulan <span class="bg-gradient-to-r from-red-500 to-amber-400 bg-clip-text text-transparent">Pitcar Academy</span>
      </h2>
      <p class="text-slate-400 text-lg leading-relaxed">Bukan sekadar belajar — kami membentuk mekanik profesional yang siap bersaing di industri otomotif.</p>
    </div>

    {/* Cards Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5">
      <!-- Card 1 — Red -->
      <div class="card-hover bg-white/[0.04] rounded-2xl p-6 border border-white/[0.08] backdrop-blur-sm">
        <div class="w-12 h-12 bg-red-500/15 rounded-xl flex items-center justify-center text-red-400 mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"/><path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="M12 2v2"/><path d="M12 22v-2"/><path d="m17 20.66-1-1.73"/><path d="M11 10.27 7 3.34"/><path d="m20.66 17-1.73-1"/><path d="m3.34 7 1.73 1"/><path d="M14 12h8"/><path d="M2 12h2"/></svg>
        </div>
        <h3 class="font-extrabold text-white text-lg mb-2">Instruktur Profesional</h3>
        <p class="text-sm text-slate-400 leading-relaxed">Dibimbing langsung oleh instruktur berpengalaman di bidang otomotif.</p>
      </div>

      <!-- Card 2 — Blue -->
      <div class="card-hover bg-white/[0.04] rounded-2xl p-6 border border-white/[0.08] backdrop-blur-sm">
        <div class="w-12 h-12 bg-blue-500/15 rounded-xl flex items-center justify-center text-blue-400 mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <h3 class="font-extrabold text-white text-lg mb-2">Praktik Langsung</h3>
        <p class="text-sm text-slate-400 leading-relaxed">OJT di bengkel Pitcar berstandar tinggi dengan peralatan modern.</p>
      </div>

      <!-- Card 3 — Amber -->
      <div class="card-hover bg-white/[0.04] rounded-2xl p-6 border border-white/[0.08] backdrop-blur-sm">
        <div class="w-12 h-12 bg-amber-500/15 rounded-xl flex items-center justify-center text-amber-400 mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <h3 class="font-extrabold text-white text-lg mb-2">Sertifikasi Resmi</h3>
        <p class="text-sm text-slate-400 leading-relaxed">Sertifikat bertahap sesuai kompetensi yang dicapai.</p>
      </div>

      <!-- Card 4 — Violet -->
      <div class="card-hover bg-white/[0.04] rounded-2xl p-6 border border-white/[0.08] backdrop-blur-sm">
        <div class="w-12 h-12 bg-violet-500/15 rounded-xl flex items-center justify-center text-violet-400 mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="font-extrabold text-white text-lg mb-2">Pelatihan Karakter</h3>
        <p class="text-sm text-slate-400 leading-relaxed">Disiplin, jujur, dan berorientasi layanan pelanggan.</p>
      </div>

      <!-- Card 5 — Emerald -->
      <div class="card-hover bg-white/[0.04] rounded-2xl p-6 border border-white/[0.08] backdrop-blur-sm">
        <div class="w-12 h-12 bg-emerald-500/15 rounded-xl flex items-center justify-center text-emerald-400 mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        </div>
        <h3 class="font-extrabold text-white text-lg mb-2">Peluang Karier</h3>
        <p class="text-sm text-slate-400 leading-relaxed">Terhubung langsung dengan jaringan Pitcar Service dan mitra.</p>
      </div>
    </div>
  </div>
</section>
