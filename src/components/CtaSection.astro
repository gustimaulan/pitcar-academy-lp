---
// Call-to-Action Bottom Banner — Bold & Energetic

interface Props {
  title?: string;
  description?: string;
  whatsappNumber?: string;
}

const {
  title = 'Wujudkan Karier Anda Sebagai Mekanik Profesional',
  description = 'Bergabunglah bersama ratusan alumni sukses Pitcar Academy. Daftar sekarang dan mulai perjalanan karier Anda.',
  whatsappNumber,
} = Astro.props;

const waNum = whatsappNumber ?? '6281234567890';
const waMessage = encodeURIComponent('Halo Pitcar Academy, saya ingin mendaftar program pelatihan mekanik!');
---

<section class="relative overflow-hidden py-24 md:py-32 lg:py-36" aria-label="Call to Action">
  {/* Bold gradient background */}
  <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-red-950 to-slate-950 z-0"></div>

  {/* Background decorations — more vivid */}
  <div class="absolute inset-0 opacity-[0.08] z-0">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="cta-pattern" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
          <circle cx="30" cy="30" r="1.5" fill="white"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#cta-pattern)"/>
    </svg>
  </div>
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-red-600/25 rounded-full blur-[150px] -translate-y-1/3 translate-x-1/3 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-amber-600/15 rounded-full blur-[150px] translate-y-1/3 -translate-x-1/3 pointer-events-none"></div>

  <div class="container-custom max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white leading-[1.1] tracking-tight max-w-4xl mx-auto mb-7 text-glow-white">
      {title}
    </h2>
    <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto mb-12 leading-relaxed">
      {description}
    </p>
    <a
      href={`https://wa.me/${waNum}?text=${waMessage}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-whatsapp text-lg px-10 py-5 shadow-2xl animate-pulse-glow"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Daftar Sekarang via WhatsApp
    </a>
    <p class="text-sm font-medium text-slate-400 mt-8">⚡ Respon cepat • Tanpa form yang rumit • Langsung terhubung dengan tim</p>
  </div>
</section>
