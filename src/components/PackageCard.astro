---
// Package Card — Bold Premium Pricing Card
import type { PackageItem } from '../content.config.ts';

interface Props {
  pkg: PackageItem;
  whatsappNumber?: string;
}

const { pkg, whatsappNumber } = Astro.props;
const waNum = whatsappNumber ?? '6281234567890';

const waMessages: Record<string, string> = {
  basic: encodeURIComponent(
    'Halo, saya tertarik dengan PAKET BASIC Maintenance Mobil EFI - Rp 5.000.000. Bagaimana cara daftarnya?'
  ),
  advanced: encodeURIComponent(
    'Halo, saya tertarik dengan PAKET ADVANCED General Repair Mobil EFI - Rp 5.000.000. Bagaimana cara daftarnya?'
  ),
  professional: encodeURIComponent(
    'Halo, saya tertarik dengan PAKET PROFESSIONAL Level 1&2 Maintenance & General Repair - Rp 8.500.000. Bagaimana cara daftarnya?'
  ),
};
---

<article
  class={`relative rounded-2xl flex flex-col justify-between overflow-hidden transition-all duration-300 card-hover ${
    pkg.highlight
      ? 'bg-white border-2 border-red-500 shadow-2xl ring-4 ring-red-500/10'
      : 'bg-white border border-slate-200 shadow-lg'
  }`}
>
  {/* Highlight Ribbon with Shimmer */}
  {pkg.highlight && (
    <div class="absolute top-3 right-3 z-10">
      <span class="bg-gradient-to-r from-red-600 via-amber-500 to-red-600 bg-[length:200%_auto] animate-shimmer text-white font-black text-[11px] uppercase tracking-wider px-4 py-1.5 rounded-full shadow-lg">
        Paling Populer 🔥
      </span>
    </div>
  )}

  <div>
    {/* Header Image */}
    {pkg.image && (
      <div class="relative w-full h-44 sm:h-48 overflow-hidden bg-slate-900">
        <img
          src={pkg.image}
          alt={`Praktik ${pkg.name} Pitcar Academy`}
          class="w-full h-full object-cover object-center filter brightness-[0.92] contrast-[1.08] transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          width="600"
          height="337"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent pointer-events-none"></div>
        <div class="absolute bottom-3 left-5 z-10">
          <span class={`inline-block font-black text-[11px] uppercase tracking-wider px-3 py-1.5 rounded-lg shadow-lg backdrop-blur-md ${
            pkg.highlight
              ? 'bg-gradient-to-r from-red-600 to-amber-500 text-white'
              : 'bg-slate-900/90 text-white border border-white/10'
          }`}>
            {pkg.level}
          </span>
        </div>
      </div>
    )}

    {/* Content */}
    <div class="p-6 sm:p-7 pb-4">
      <h3 class="font-black text-slate-900 text-lg sm:text-xl leading-tight">{pkg.name}</h3>
      <p class="mt-2.5 text-slate-500 text-sm leading-relaxed">{pkg.description}</p>
    </div>

    <hr class="mx-6 sm:mx-7 border-slate-100" />

    {/* Details Grid */}
    <div class="p-6 sm:p-7 grid grid-cols-2 gap-4">
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 bg-red-50 border border-red-200/60 rounded-lg flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div>
          <div class="font-bold text-slate-900 text-sm">{pkg.duration}</div>
          <div class="text-xs text-slate-500 font-medium">{pkg.hours}</div>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 bg-blue-50 border border-blue-200/60 rounded-lg flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
          <div class="font-bold text-slate-900 text-sm">OJT Bengkel</div>
          <div class="text-xs text-slate-500 font-medium">{pkg.ojt}</div>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 bg-emerald-50 border border-emerald-200/60 rounded-lg flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/></svg>
        </div>
        <div>
          <div class="font-bold text-slate-900 text-sm">Kick Off</div>
          <div class="text-xs text-slate-500 font-medium">{pkg.kickOff}</div>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <div class="w-9 h-9 bg-purple-50 border border-purple-200/60 rounded-lg flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9333EA" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/></svg>
        </div>
        <div>
          <div class="font-bold text-slate-900 text-sm">Sertifikat</div>
          <div class="text-xs text-slate-500 font-medium line-clamp-2">{pkg.certificate}</div>
        </div>
      </div>
    </div>

    {/* Expandable Details */}
    <details class="group px-6 sm:px-7 pb-4">
      <summary class="list-none cursor-pointer select-none text-sm font-bold text-red-600 hover:text-red-700 inline-flex items-center gap-1.5 transition-colors outline-none">
        <span class="group-open:hidden">Lihat Materi & Hasil Kelulusan</span>
        <span class="hidden group-open:inline">Sembunyikan Detail</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <div class="pt-4 space-y-5 border-t border-slate-100 mt-3">
        <div>
          <h4 class="font-extrabold text-slate-900 text-xs uppercase tracking-wider mb-2.5">📚 Materi Pembelajaran:</h4>
          <ul class="space-y-1.5">
            {pkg.materials.map(item => (
              <li class="text-xs sm:text-sm text-slate-700 font-medium flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" class="mt-0.5 shrink-0" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h4 class="font-extrabold text-slate-900 text-xs uppercase tracking-wider mb-2.5">🎯 Setelah Lulus Mampu:</h4>
          <ul class="space-y-1.5">
            {pkg.outcomes.map(item => (
              <li class="text-xs sm:text-sm text-slate-700 font-medium flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" class="mt-0.5 shrink-0" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </details>
  </div>

  {/* Bold Pricing Footer */}
  <div class={`p-6 sm:p-7 pt-5 ${pkg.highlight ? 'bg-slate-950' : 'bg-slate-900'}`}>
    <div class="text-center mb-5">
      <span class="text-slate-400 font-bold text-[11px] uppercase tracking-widest">Investasi Pelatihan</span>
      <div class="text-3xl sm:text-4xl font-black text-white mt-1.5 tracking-tight">{pkg.priceDisplay}</div>
    </div>
    <a
      href={`https://wa.me/${waNum}?text=${waMessages[pkg.id]}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-whatsapp w-full justify-center gap-2 text-base"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Daftar Paket Ini
    </a>
  </div>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
