---
// FAQ Section — Accordion style FAQ
// No extra CTA — conversion handled by Hero (top), Sticky Float, and Bottom Banner

interface Props {
  faqs: Array<{ question: string; answer: string }>;
  whatsappNumber?: string;
}

const { faqs } = Astro.props;
---

<section id="faq" class="section-padding bg-white border-t border-slate-200/60 overflow-hidden" aria-label="Pertanyaan Umum">
  <div class="container-custom max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Header */}
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 bg-red-50 text-red-700 font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-full border border-red-200/80 mb-5">
        <span class="w-2 h-2 rounded-full bg-red-600"></span>
        FAQ
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-[1.1] text-slate-900 mb-5 tracking-tight">
        Pertanyaan Yang Sering <span class="bg-gradient-to-r from-red-600 to-red-500 bg-clip-text text-transparent">Ditanyakan</span>
      </h2>
      <p class="text-slate-500 text-lg leading-relaxed">Temukan jawaban untuk pertanyaan umum seputar program pelatihan kami.</p>
    </div>

    {/* FAQ List */}
    <div class="max-w-3xl mx-auto space-y-4">
      {faqs.map((faq, index) => (
        <div class="faq-item bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-slate-300 transition-all duration-200 overflow-hidden">
          <button
            class="w-full flex items-center justify-between p-5 sm:p-6 text-left focus-visible:outline-none hover:bg-slate-50/80 transition-colors"
            data-faq-index={index}
            aria-expanded="false"
          >
            <span class="font-bold text-slate-900 text-base sm:text-lg pr-4">{faq.question}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="faq-chevron shrink-0 text-slate-500 transition-transform duration-300" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="faq-answer-content max-h-0 overflow-hidden transition-all duration-300" data-faq-index={index}>
            <div class="px-5 sm:px-6 pb-6 pt-1 text-slate-700 text-sm sm:text-base leading-relaxed border-t border-slate-100">
              {faq.answer}
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Contact Prompt — Reference to main CTAs instead of redundant button */}
    <div class="text-center mt-14 p-8 bg-slate-900 rounded-2xl border border-slate-800 max-w-xl mx-auto shadow-xl">
      <h3 class="text-xl font-black text-white mb-2">Masih punya pertanyaan lain?</h3>
      <p class="text-slate-300 text-sm mb-4">Tim konsultan pendidikan kami siap membantu memberikan informasi lebih detail.</p>
      <p class="text-sm text-slate-400">💬 Gunakan tombol WhatsApp di pojok kanan bawah layar untuk bertanya langsung.</p>
    </div>
  </div>
</section>

<style is:global>
  .faq-chevron.rotated {
    transform: rotate(180deg);
  }
  .faq-answer-content.open {
    max-height: 400px !important;
  }
</style>

<script>
  function initFaq() {
    document.querySelectorAll('[data-faq-index]').forEach(button => {
      if (button.tagName === 'BUTTON') {
        button.addEventListener('click', () => {
          const idx = button.getAttribute('data-faq-index');
          const content = document.querySelector(`[data-faq-index="${idx}"][class*="faq-answer"]`);
          const chevron = button.querySelector('.faq-chevron');
          if (content && chevron) {
            content.classList.toggle('open');
            chevron.classList.toggle('rotated');
            button.setAttribute('aria-expanded', String(content.classList.contains('open')));
          }
        });
      }
    });
  }
  initFaq();
</script>
